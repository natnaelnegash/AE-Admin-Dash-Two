# AE Admin Dashboard — Environment Variables

# ── API ─────────────────────────────────────────────────────────────────────
# Base URL for the AEBackend REST API (no trailing slash)
VITE_API_URL=http://localhost:3000/api

# ── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to enable mock data globally for modules without live endpoints.
# Overridden per-feature in adminService.ts once an endpoint goes live.
# Keep as "false" in production.
VITE_USE_MOCK=false
